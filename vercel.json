{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*\\.(html|css|js|json|png|jpg|ico|svg))", "dest": "public/$1" },
    { "src": "/", "dest": "public/login.html" },
    { "src": "/(.*)", "dest": "public/$1.html" }
  ]
}
